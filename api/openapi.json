{
  "openapi": "3.1.0",
  "info": {
    "title": "Cat Fact API",
    "description": "An API that shows different Cat Facts!",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cat-fact.herokuapp.com/facts"
    }
  ],
  "paths": {
    "/random": {
      "parameters": [
        {
          "$ref": "#/components/parameters/amount"
        }
      ],
      "get": {
        "summary": "Get a random cat fact",
        "operationId": "GetRandom",
        "responses": {
          "200": {
            "$ref": "#/components/responses/CatFactResponse"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailableResponse"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRandomOkJSONResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/GetRandomOkJSONResponseStatus"
          },
          "_id": {
            "type": "string",
            "example": "591f9890d369931519ce3564"
          },
          "user": {
            "type": "string",
            "example": "5a9ac18c7478810ea6c06381"
          },
          "text": {
            "type": "string",
            "example": "A cat's normal pulse is 140-240 beats per minute, with an average of 195."
          },
          "type": {
            "type": "string",
            "example": "cat"
          },
          "deleted": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2018-08-04T20:20:02.737Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2020-08-23T20:20:01.611Z"
          },
          "__v": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "status",
          "_id",
          "user",
          "text",
          "type",
          "deleted",
          "createdAt",
          "updatedAt",
          "__v"
        ],
        "example": {
          "status": {
            "verified": true,
            "sentCount": 1
          },
          "_id": "591f9890d369931519ce3564",
          "user": "5a9ac18c7478810ea6c06381",
          "text": "A cat's normal pulse is 140-240 beats per minute, with an average of 195.",
          "type": "cat",
          "deleted": false,
          "createdAt": "2018-08-04T20:20:02.737Z",
          "updatedAt": "2020-08-23T20:20:01.611Z",
          "__v": 0
        }
      },
      "GetRandomOkJSONResponseStatus": {
        "type": "object",
        "properties": {
          "verified": {
            "type": "boolean"
          },
          "sentCount": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "verified",
          "sentCount"
        ],
        "example": {
          "verified": true,
          "sentCount": 0
        }
      }
    },
    "responses": {
      "ServiceUnavailableResponse": {
        "description": "Returns an HTML page reporting an application error",
        "content": {
          "text/html": {
            "example": "<!DOCTYPE html>\n\t<html>\n\t  <head>\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t\t<meta charset=\"utf-8\">\n\t\t<title>Application Error</title>\n\t\t<style media=\"screen\">\n\t\t  html,body,iframe {\n\t\t\tmargin: 0;\n\t\t\tpadding: 0;\n\t\t  }\n\t\t  html,body {\n\t\t\theight: 100%;\n\t\t\toverflow: hidden;\n\t\t  }\n\t\t  iframe {\n\t\t\twidth: 100%;\n\t\t\theight: 100%;\n\t\t\tborder: 0;\n\t\t  }\n\t\t</style>\n\t  </head>\n\t  <body>\n\t\t<iframe src=\"//www.herokucdn.com/error-pages/application-error.html\"></iframe>\n\t  </body>\n\t</html>"
          }
        }
      },
      "CatFactResponse": {
        "description": "Returns a cat fact",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GetRandomOkJSONResponse"
            },
            "example": {
              "status": {
                "verified": true,
                "sentCount": 0
              },
              "_id": "591f9890d369931519ce3564",
              "user": "5a9ac18c7478810ea6c06381",
              "text": "A cat's normal pulse is 140-240 beats per minute, with an average of 195.",
              "type": "cat",
              "deleted": false,
              "createdAt": "2018-08-04T20:20:02.737Z",
              "updatedAt": "2020-08-23T20:20:01.611Z",
              "__v": 0
            }
          }
        }
      }
    },
    "parameters": {
      "amount": {
        "name": "amount",
        "in": "query",
        "description": "The number of cat facts to return",
        "schema": {
          "type": "integer",
          "example": 1
        },
        "example": 1
      }
    }
  },
  "externalDocs": {
    "description": "API documentation",
    "url": "https://alexwohlbruck.github.io/cat-facts/docs/"
  }
}