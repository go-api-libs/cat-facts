{
  "openapi": "3.1.0",
  "info": {
    "title": "Cat Fact API",
    "description": "An API that shows different Cat Facts!",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cat-fact.herokuapp.com"
    }
  ],
  "paths": {
    "/facts/random": {
      "parameters": [
        {
          "$ref": "#/components/parameters/amount"
        },
        {
          "$ref": "#/components/parameters/animal_type"
        }
      ],
      "get": {
        "summary": "Get random cat facts",
        "description": "Returns random cat facts\nNOTE: `amount` parameter must be greater than 1 due to inconsistent responses from the API",
        "operationId": "GetRandom",
        "responses": {
          "200": {
            "$ref": "#/components/responses/FactsResponse"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailableResponse"
          }
        }
      }
    },
    "/facts/{id}": {
      "get": {
        "operationId": "GetFactByID",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Fact"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Facts": {
        "description": "A slice of simple fact objects",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SimpleFact"
        },
