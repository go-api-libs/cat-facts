          "type": {
            "type": "string",
            "example": "cat"
          },
          "deleted": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2018-08-04T20:20:02.737Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2020-08-23T20:20:01.611Z"
          },
          "__v": {
            "type": "integer",
            "example": 0
