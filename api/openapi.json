    "parameters": {
      "amount": {
        "name": "amount",
        "in": "query",
        "description": "The number of cat facts to return\nNOTE: Must be greater than 1 due to inconsistent responses from the API",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 2,
          "min": 2
        },
        "example": 2
      },
      "animal_type": {
        "name": "animal_type",
        "in": "query",
        "description": "The type of animal",
        "schema": {
          "type": "string",
          "enum": [
            "cat",
            "dog",
            "snail",
            "horse"
          ],
          "example": "cat"
        },
        "example": "cat"
      },
      "id": {
        "name": "id",
        "in": "path",
        "description": "The id of a fact",
        "required": true,
        "schema": {
          "type": "string",
          "example": "591f9890d369931519ce3564"
        }
      }
    }
  },
